# MedNexus Frontend Environment Configuration
# For local single-machine development:
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_AI_URL=http://localhost:8001
NEXT_PUBLIC_CUSTOM_DOMAIN=app.mednexus.in

